{
  "functions": {
    "api/chat.js": { "maxDuration": 30 },
    "api/voz.js": { "maxDuration": 30 },
    "api/transcribir.js": { "maxDuration": 60 },
    "api/resumen.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), screen-wake-lock=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
